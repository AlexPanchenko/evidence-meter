# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environment
.venv/

# Secrets and local environment (.env.example stays tracked)
.env
.env.*
!.env.example
*.pem
*.key
credentials*

# Personal Claude Code files (shared ones are .claude/settings.json, AGENTS.md and CLAUDE.md)
.claude/settings.local.json
CLAUDE.local.md
.claude/instructions-loaded.jsonl

# Private definitions (organisation codes and thresholds); normally kept outside the repository
*.private.*
private/

# Local identifier list (client and project identifiers the guard checks against)
identifiers.local.*

# Real data; only synthetic and public data may be committed
data/real/
data/raw/

# Local database and runtime files
var/

# Web app build output and dependencies (also in web/.gitignore)
web/node_modules/
web/dist/

# OS and editors
.DS_Store
.idea/
.vscode/

# Per-developer SDLC plugin settings and agent worktrees
.claude/*.local.md
.worktrees/
