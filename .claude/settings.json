{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv lock)",
      "Bash(uv tree)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format *)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make check)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(uv add *)",
      "Bash(uv remove *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(*.private.*)",
      "Read(**/private/**)",
      "Edit(*.private.*)",
      "Read(~/.config/evidence-meter/**)",
      "Read(identifiers.local.*)",
      "Edit(identifiers.local.*)",
      "Read(**/data/real/**)",
      "Read(**/data/raw/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
